rules_version = '2';

// เข้าถึงข้อมูลได้ต่อเมื่อ login ผ่าน Firebase Auth แล้วเท่านั้น (ปิดการเข้าถึงแบบสาธารณะทั้งหมด)
// users / units แก้ไขได้เฉพาะ role=ADMIN เท่านั้น (incidents/tasks ยังเปิดให้ทุก role ที่ login แล้ว
// อ่าน/เขียนได้เท่ากัน เพราะทุกหน่วยงานต้องอัปเดตสถานะงานของตัวเองได้)
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "ADMIN";
    }

    match /users/{uid} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /units/{unitCode} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if isSignedIn();
    }
  }
}
