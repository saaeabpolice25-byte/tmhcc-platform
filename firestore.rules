rules_version = '2';

// เข้าถึงข้อมูลได้ต่อเมื่อ login ผ่าน Firebase Auth แล้วเท่านั้น (ปิดการเข้าถึงแบบสาธารณะทั้งหมด)
// หมายเหตุ: ยังไม่ได้แยกสิทธิ์ตาม role (VHV/HOSPITAL/ADMIN) — ทุกคนที่ login แล้วเข้าถึงได้เท่ากันหมด
service cloud.firestore {
  match /databases/{database}/documents {
    // อนุญาตให้ "อ่าน" collection units แบบไม่ต้อง login ได้ (แค่ Group ID เชื่อมกลุ่ม LINE
    // ไม่ใช่ข้อมูลเคส/ผู้ป่วย) เพื่อให้ API route (app/api/notify-line, line-webhook) ที่ยังใช้
    // Firestore client SDK แบบไม่ผูก service account อ่านค่านี้ได้โดยไม่ต้องตั้ง Firebase Admin SDK เพิ่ม
    match /units/{unitCode} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
